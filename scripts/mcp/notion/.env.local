# Notion MCP connection settings.
# Copy this file to scripts/mcp/envs/notion.env and adjust values locally.
# Never commit scripts/mcp/envs/notion.env or the token values below.
# This file is sourced as Bash; do not paste untrusted content into it.

# Notion integration token or personal access token.
MCP_NOTION_TOKEN=ntn_***

# The shared Notion MCP intentionally exposes both read and write operations.
# Limit accessible pages and capabilities in the Notion integration settings.
